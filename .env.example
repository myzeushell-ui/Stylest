# ───────────────────────────────────────────────────────────────
# «Образ» — пример переменных окружения.
# Скопируй в .env и заполни. .env НИКОГДА не коммитится (см. .gitignore).
# ВАЖНО: все ключи — только на бэкенде (apps/api). В клиенте ключей нет.
# ───────────────────────────────────────────────────────────────

# --- Бэкенд (apps/api) ---
PORT=8787

# AIProvider. Если ключ пустой — автоматически используется MockAIProvider
# (приложение работает без оплаты внешних API).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Какой провайдер использовать. mock | anthropic (по умолчанию выбирается
# автоматически: anthropic если есть ключ, иначе mock).
AI_PROVIDER=

# Тяжёлые провайдеры. На старте всегда mock (см. ДОПУЩЕНИЕ в коде).
SKIN_PROVIDER=mock
TRYON_PROVIDER=mock
MARKETPLACE_PROVIDER=mock

# --- Supabase (self-hosted, без западной карты) ---
# Заполняется на этапе подключения реальной БД/Storage. Плейсхолдеры.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres для Prisma (Supabase даёт строку подключения).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/obraz?schema=public

# --- Фронтенд (apps/web), переменные с префиксом VITE_ попадают в клиент ---
# Ключей здесь быть НЕ ДОЛЖНО — только публичные URL.
VITE_API_BASE_URL=http://localhost:8787
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
